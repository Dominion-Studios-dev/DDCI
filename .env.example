# ============================================================================
# .env.example — DDCI environment file template
#
# Copy to `.env` (or export the same variables). The `.env` file is loaded
# automatically; keep it owner-only (chmod 600 .env). ddci's first-run
# wizard creates it for you with the correct permissions.
# ============================================================================

# Your Groq API key (https://console.groq.com/keys).
# An OPENAI_API_KEY is accepted as a fallback.
GROQ_API_KEY=

# Optional overrides
# MODEL_NAME=llama-3.3-70b-versatile
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# MAX_L1_TOKENS=8192
# DB_PATH=ddci_memory.db